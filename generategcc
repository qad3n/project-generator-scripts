#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

readonly languages=(c cpp asm rust)
# cmake reserved target names plus files the binary would overwrite in the project root
readonly cmakeReserved=(all clean depend edit_cache help install package preinstall rebuild_cache build include out src)
readonly strictFlags='-Wall -Wextra -Wshadow -Wconversion -Wsign-conversion
	-Wcast-align -Wformat=2 -Wundef -pedantic -fstack-protector-strong'

log()   { printf '[+] %s\n' "$*"; }
warn()  { printf '[!] %s\n' "$*" >&2; }
error() { printf '[x] %s\n' "$*" >&2; exit 1; }

require() { command -v "$1" &>/dev/null || error "Required '$1' not found."; }
contains() { local item; for item in "${@:2}"; do [[ $item == "$1" ]] && return 0; done; return 1; }
sanitizeName() { local name="${1//[ -]/_}"; printf '%s\n' "${name//[^A-Za-z0-9_]/}"; }
readKey() { read -rsn1 -p "$1" "$2" || error "No input."; echo; }

usage()
{
	local IFS=/
	cat <<-EOF
	Usage: ${0##*/} [options]
	  -n | --name <project>   Project name
	  -l | --lang <language>  Language: ${languages[*]}
	  -y | --yes              Skip confirmation
	  -h | --help             Show this help
	EOF
	exit "${1:-0}"
}

langC()
{
	create=createCmake
	tools=(cmake gcc)
	reserved=("${cmakeReserved[@]}")
	arch=
	cmakeLang=C
	ext=c
	standard=11
	flags="$strictFlags -Wstrict-prototypes"
	sample='#include <stdio.h>

int main(void)
{
	puts("Hello, C World!");
	return 0;
}'
}

langCpp()
{
	create=createCmake
	tools=(cmake g++)
	reserved=("${cmakeReserved[@]}")
	arch=
	cmakeLang=CXX
	ext=cpp
	standard=17
	flags=$strictFlags
	sample='#include <iostream>

int main()
{
	std::cout << "Hello, C++ World!\n";
	return 0;
}'
}

langAsm()
{
	create=createCmake
	tools=(cmake nasm ld)
	reserved=("${cmakeReserved[@]}")
	arch=x86_64
	cmakeLang=ASM_NASM
	ext=asm
	standard=
	flags=
	sample='global _start

section .data
	msg db "Hello, ASM World!", 0x0A
	len equ $ - msg

section .text
_start:
	mov rax, 1
	mov rdi, 1
	mov rsi, msg
	mov rdx, len
	syscall

	mov rax, 60
	xor rdi, rdi
	syscall

section .note.GNU-stack noalloc noexec nowrite progbits'
}

langRust()
{
	create=createCargo
	tools=(cargo)
	# cargo validates package names itself before creating anything
	reserved=()
	arch=
	sample='fn main() {
    println!("Hello, Rust World!");
}'
}

nameProblem()
{
	if [[ -z $1 ]]; then
		echo "Name cannot be empty."
	elif contains "$1" "${reserved[@]}"; then
		echo "Name '$1' is reserved."
	elif [[ -e $1 ]]; then
		echo "Directory '$1' already exists."
	fi
}

promptName()
{
	local input problem
	while :; do
		read -rp "Enter project name: " input || error "No input."
		projectName=$(sanitizeName "$input")
		problem=$(nameProblem "$projectName")
		[[ -z $problem ]] && return
		warn "$problem"
	done
}

promptLanguage()
{
	local i choice
	echo "Supported languages:"
	for i in "${!languages[@]}"; do
		printf '  [%d] %s\n' $((i + 1)) "${languages[i]}"
	done
	while :; do
		readKey "Select language [1-${#languages[@]}]: " choice
		if [[ $choice == [1-9] ]] && (( choice <= ${#languages[@]} )); then
			lang=${languages[choice - 1]}
			return
		fi
		warn "Invalid selection '$choice'."
	done
}

confirm()
{
	local answer
	while :; do
		readKey "Proceed? [y/n]: " answer
		case "${answer,,}" in
			y) return ;;
			n) log "Aborted."; exit 0 ;;
			*) warn "Invalid selection '$answer'." ;;
		esac
	done
}

writeCmakeLists()
{
	local standardBlock="" flagsBlock=""
	if [[ -n $standard ]]; then
		standardBlock="set(CMAKE_${cmakeLang}_STANDARD $standard)
set(CMAKE_${cmakeLang}_STANDARD_REQUIRED ON)
set(CMAKE_${cmakeLang}_EXTENSIONS OFF)
"
	fi
	if [[ -n $flags ]]; then
		flagsBlock="target_compile_options(\${PROJECT_NAME} PRIVATE
	$flags
)
"
	fi

	cat >CMakeLists.txt <<-EOF
	cmake_minimum_required(VERSION 3.16)
	project($projectName LANGUAGES $cmakeLang)

	${standardBlock}set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

	file(GLOB_RECURSE sources CONFIGURE_DEPENDS src/*.$ext)
	add_executable(\${PROJECT_NAME} \${sources})
	target_include_directories(\${PROJECT_NAME} PRIVATE include)
	${flagsBlock}set_target_properties(\${PROJECT_NAME} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "\${PROJECT_SOURCE_DIR}")
	EOF
}

createCmake()
{
	mkdir -p "$projectName"/{src,include}
	cd "$projectName"
	git init -q
	printf '%s\n' "$sample" >"src/main.$ext"
	writeCmakeLists

	cat >.gitignore <<-EOF
	/out*/
	/.cache/
	/$projectName
	EOF

	cat >.clangd <<-'EOF'
	CompileFlags:
	  CompilationDatabase: out
	EOF

	cat >build <<-'EOF'
	#!/usr/bin/env bash
	set -euo pipefail
	cd "$(dirname "$0")"
	cmake -S . -B out -DCMAKE_BUILD_TYPE="${1:-Release}"
	cmake --build out --parallel "$(nproc)"
	EOF
	chmod +x build

	log "Building..."
	./build
	./"$projectName"
}

createCargo()
{
	cargo new --quiet --vcs git "$projectName"
	cd "$projectName"
	printf '%s\n' "$sample" >src/main.rs

	# camelCase function names need non_snake_case allowed
	cat >>Cargo.toml <<-'EOF'

	[lints.rust]
	unsafe_code = "deny"
	non_snake_case = "allow"

	[lints.clippy]
	unwrap_used = "deny"
	expect_used = "deny"
	todo = "deny"
	unimplemented = "deny"
	panic = "deny"
	unused_result_ok = "deny"
	let_underscore_must_use = "deny"
	EOF

	# unstable keys need cargo +nightly fmt
	cat >rustfmt.toml <<-'EOF'
	edition = "2024"
	unstable_features = true
	max_width = 120
	use_small_heuristics = "Max"
	single_line_if_else_max_width = 50
	tab_spaces = 4
	newline_style = "Unix"
	fn_single_line = true
	where_single_line = true
	empty_item_single_line = true
	hex_literal_case = "Upper"
	imports_granularity = "Module"
	group_imports = "One"
	use_field_init_shorthand = true
	blank_lines_upper_bound = 1
	EOF

	cat >clippy.toml <<-'EOF'
	allow-unwrap-in-tests = true
	allow-expect-in-tests = true
	allow-panic-in-tests = true
	EOF

	log "Building..."
	cargo run --quiet
}

projectName=""
lang=""
autoYes=false

while (( $# )); do
	case "$1" in
		-n|--name) [[ $# -ge 2 ]] || usage 1; projectName=$(sanitizeName "$2"); shift 2 ;;
		-l|--lang) [[ $# -ge 2 ]] || usage 1; lang="${2,,}"; shift 2 ;;
		-y|--yes) autoYes=true; shift ;;
		-h|--help) usage ;;
		*) warn "Ignoring unknown argument '$1'."; shift ;;
	esac
done

require git

if [[ -t 0 ]]; then
	# disable the kitty keyboard protocol so single key reads return plain characters
	printf '\e[>0u' >/dev/tty 2>/dev/null || true
	trap 'printf "\e[<u" >/dev/tty 2>/dev/null || true' EXIT
fi

if [[ -z $lang ]]; then
	promptLanguage
fi
contains "$lang" "${languages[@]}" || error "Unsupported language '$lang'."
"lang${lang^}"

if [[ -n $arch && $(uname -m) != "$arch" ]]; then
	error "$lang is only supported on $arch."
fi
for tool in "${tools[@]}"; do
	require "$tool"
done

if [[ -z $projectName ]]; then
	promptName
fi
problem=$(nameProblem "$projectName")
[[ -z $problem ]] || error "$problem"

cat <<EOF
Project: $projectName
Language: $lang
Directory: $PWD/$projectName
EOF
if ! $autoYes; then
	confirm
fi

log "Creating project..."
"$create"

log "Setup complete in $projectName/"

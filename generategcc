#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

if [[ -t 0 ]]; then
	printf '\e[>0u' >/dev/tty 2>/dev/null || true
	trap 'printf "\e[<u" >/dev/tty 2>/dev/null || true' EXIT
fi

log()   { printf "[✓] %s\n" "$*"; }
warn()  { printf "[!] %s\n" "$*"; }
error() { printf "[✗] %s\n" "$*" >&2; exit 1; }

require() { command -v "$1" &>/dev/null || error "Required '$1' not found."; }
require cmake
require git

projectName=""
lang=""
autoYes=false
cxxStandard=17

sanitizeName() { local n="${1// /_}"; n="${n//-/_}"; printf '%s\n' "${n//[^A-Za-z0-9_]/}"; }

# usage help
usage()
{
	cat <<-EOF
	Usage: $0 [options]
	  -n | --name <project>   Project name
	  -l | --lang <language>  Language: c / cpp / asm
	  -y | --yes              Skip confirmation
	  -h | --help             Show this help
	EOF
	exit 1
}

# commands
while (( $# )); do
	case "$1" in
		-n|--name) [[ $# -ge 2 ]] || usage; projectName=$(sanitizeName "$2"); shift 2;;
		-l|--lang) [[ $# -ge 2 ]] || usage; lang="${2,,}"; shift 2;;
		-y|--yes) autoYes=true; shift;;
		-h|--help) usage;;
		*) warn "Ignoring unknown argument '$1'."; shift;;
	esac
done

# name prompt
while [[ -z $projectName ]]; do
	read -rp "Enter project name: " tmp
	projectName=$(sanitizeName "$tmp")
	[[ -z $projectName ]] && { warn "Name cannot be empty."; continue; }
	[[ -e $projectName ]] && { warn "Directory exists."; projectName=""; }
done

[[ -e $projectName ]] && error "Directory '$projectName' already exists."

# language prompt
if [[ -z $lang ]]; then
	while :; do
		echo "Supported languages:"
		echo "  [1] c"
		echo "  [2] cpp"
		echo "  [3] asm"
		read -rsn1 -p "Select language [1-3]: " choice
		echo
		case "$choice" in
			1) lang=c; break ;;
			2) lang=cpp; break ;;
			3) lang=asm; break ;;
			*) warn "Invalid selection '$choice'." ;;
		esac
	done
else
	case "$lang" in
		c|cpp|asm) ;;
		*) error "Unsupported language '$lang'" ;;
	esac
fi

# requirement checks
case "$lang" in
	c) cmakeLang=C; ext=c; require gcc ;;
	cpp) cmakeLang=CXX; ext=cpp; require g++ ;;
	asm)
		[[ "$(uname -m)" == x86_64 ]] || error "ASM (NASM) is only supported on x86_64."
		cmakeLang=ASM_NASM; ext=asm; require nasm; require ld
		;;
esac

# confirm
cat <<EOF
Project: $projectName
Language: $lang
Directory: $PWD/$projectName
EOF
if ! $autoYes; then
	while :; do
		read -rsn1 -p "Proceed? [y/n]: " ans
		echo
		case "${ans,,}" in
			y) break ;;
			n) log "Aborted."; exit ;;
			*) warn "Invalid selection '$ans'." ;;
		esac
	done
fi

# initialize structure
log "Creating project structure..."
mkdir -p "$projectName"/{src,include}
cd "$projectName"

# samples
srcFile="src/main.$ext"
case "$lang" in
	c) cat >"$srcFile" <<'EOF'
#include <stdio.h>
int main(void){ puts("Hello, C World!"); return 0; }
EOF
	;;
	cpp) cat >"$srcFile" <<'EOF'
#include <iostream>
int main(){ std::cout<<"Hello, C++ World!\n"; return 0; }
EOF
	;;
	asm) cat >"$srcFile" <<'EOF'
global _start
section .data
	msg db "Hello, ASM World!",0x0A
	len equ $-msg
section .text
_start:
	mov rax,1;
	mov rdi,1;
	mov rsi,msg;
	mov rdx,len;
	syscall
	mov rax,60;
	xor rdi,rdi;
	syscall
EOF
	;;
esac
log "Added $srcFile"

# cmake setup
case "$cmakeLang" in
	CXX)
		stdBlock="set(CMAKE_CXX_STANDARD $cxxStandard)
set(CMAKE_CXX_STANDARD_REQUIRED ON)"
		;;
	C)
		stdBlock="set(CMAKE_C_STANDARD 11)
set(CMAKE_C_STANDARD_REQUIRED ON)"
		;;
	*) stdBlock="" ;;
esac

flagsBlock=""
if [[ $cmakeLang != ASM_NASM ]]; then
	strictProtos=""
	[[ $cmakeLang == C ]] && strictProtos=$'\n\t-Wstrict-prototypes'
	flagsBlock="add_compile_options(
	-Wall -Wextra -Wshadow -Wconversion -Wsign-conversion
	-Wcast-align -Wformat=2 -Wundef
	-pedantic -fstack-protector-strong$strictProtos
)"
fi

cat > CMakeLists.txt <<CMAKE_EOF
cmake_minimum_required(VERSION 3.16)
project($projectName LANGUAGES $cmakeLang)

$stdBlock

$flagsBlock

include_directories(include)

file(GLOB_RECURSE PROJECT_SOURCES CONFIGURE_DEPENDS
	src/*.$ext
)

add_executable(\${PROJECT_NAME} \${PROJECT_SOURCES})

set_target_properties(\${PROJECT_NAME} PROPERTIES
	RUNTIME_OUTPUT_DIRECTORY "\${CMAKE_SOURCE_DIR}"
)
CMAKE_EOF

log "Initializing git repository..."
git init -q
cat > .gitignore <<EOF
/out*/
/*.o
/*.obj
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
EOF

cat > build <<'BUILDEOF'
#!/usr/bin/env bash
set -euo pipefail
cmake -S . -B out -DCMAKE_BUILD_TYPE="${1:-Release}"
cmake --build out --parallel "$(nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)"
BUILDEOF
chmod +x build

log "Invoking initial build..."
./build
./"$projectName"

log "Setup complete. Binary: ./$projectName"